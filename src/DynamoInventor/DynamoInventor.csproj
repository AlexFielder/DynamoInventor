<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Inventor add-in (ApplicationAddInServer) that hosts Dynamo in-process.

    Loading model (proved by spike\AsmSpike on 2026-09-16):
      - Inventor loads the add-in into the Default AssemblyLoadContext (UseInventorAssemblyContext=1).
      - Dynamo assemblies are NOT shipped next to this DLL; a Resolving handler probes the
        DynamoCoreRuntime folder ($(DynamoRuntimeRoot)) at runtime.
      - ASM comes from Inventor itself (Autodesk Shared Components); Dynamo's libG binds to it.
  -->

  <PropertyGroup>
    <RootNamespace>DynamoInventor</RootNamespace>
    <AssemblyName>DynamoInventor</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Inventor CoCreateInstances the add-in class; without COM visibility Activate() is never called. -->
    <ComVisible>true</ComVisible>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(StdOlePath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- WpfUILibrary brings DynamoCoreWpf + Core (DynamoCore, DynamoApplications, DynamoShapeManager, ...). -->
    <PackageReference Include="DynamoVisualProgramming.WpfUILibrary" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dynamo-derived types live in Host; see the note in that project. -->
    <ProjectReference Include="..\DynamoInventor.Host\DynamoInventor.Host.csproj" />
    <ProjectReference Include="..\Libraries\Inventor\DSInventorNodes\InventorLibrary.csproj" />
    <ProjectReference Include="..\Libraries\Inventor\InventorServices\InventorServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Autodesk.DynamoInventor.Inventor.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Images\**" />
    <None Remove="doc\**" />
    <None Remove="NodeGeneration\**" />
    <Compile Remove="NodeGeneration\**" />
  </ItemGroup>

</Project>
