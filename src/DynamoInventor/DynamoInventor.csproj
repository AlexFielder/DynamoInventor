<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Inventor add-in (ApplicationAddInServer): a ribbon button that launches DynamoInventor.App.exe.

    This assembly deliberately has NO Dynamo dependency. Two reasons, both verified 2026-09-16:
      - Inventor's add-in loader reflects over every type here before Activate() runs, so any type
        deriving from a not-yet-resolvable assembly stops the add-in loading at all.
      - Dynamo cannot run inside Inventor 2027's process anyway: Inventor pins WebView2 SDK 1.0.1210
        in the default AssemblyLoadContext and Dynamo 4.2 needs 1.0.2478.
  -->

  <PropertyGroup>
    <RootNamespace>DynamoInventor</RootNamespace>
    <AssemblyName>DynamoInventor</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Inventor CoCreateInstances the add-in class; without COM visibility Activate() is never called. -->
    <ComVisible>true</ComVisible>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(StdOlePath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Autodesk.DynamoInventor.Inventor.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Images\**" />
    <None Remove="doc\**" />
  </ItemGroup>

</Project>
