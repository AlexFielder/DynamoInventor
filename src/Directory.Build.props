<Project>

  <!--
    Shared build settings for DynamoInventor (Dynamo Core 4.x on Inventor 2027).

    Runtime pairing is dictated by the CLR each side runs on:
      Dynamo 4.x  = .NET 10  = Inventor 2027 (Bin\ClrAddinLoader.runtimeconfig.json says net10.0)
      Dynamo 3.x  = .NET 8   = Inventor 2025 / 2026
    Change InventorVersion and DynamoVersion together, never one alone.
  -->

  <PropertyGroup>
    <InventorVersion Condition="'$(InventorVersion)' == ''">2027</InventorVersion>
    <DynamoVersion Condition="'$(DynamoVersion)' == ''">4.2.1.5887</DynamoVersion>

    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Assembly metadata generated by the SDK; the old per-project AssemblyInfo.cs files are gone. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.0.0</Version>
    <Product>DynamoInventor</Product>
    <Company>AFAutomations</Company>
    <Copyright>Copyright 2012 Autodesk, Inc.; 2026 AFAutomations</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Inventor SDK locations. The interop is referenced with Private=false: at runtime the
    add-in binds to whatever Inventor.exe already has loaded.
  -->
  <PropertyGroup>
    <InventorBinRoot Condition="'$(InventorBinRoot)' == ''">C:\Program Files\Autodesk\Inventor $(InventorVersion)\Bin</InventorBinRoot>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(InventorBinRoot)\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
    <StdOlePath Condition="'$(StdOlePath)' == ''">$(InventorBinRoot)\stdole.dll</StdOlePath>
  </PropertyGroup>

  <!--
    Dynamo runtime location, used only by deploy scripts and the add-in's assembly resolver.
    Compile-time references come from the DynamoVisualProgramming.* NuGet packages, which
    are consumed with ExcludeAssets=runtime so nothing from Dynamo is copied into bin\.
  -->
  <PropertyGroup>
    <DynamoRuntimeRoot Condition="'$(DynamoRuntimeRoot)' == ''">C:\AFAutomations\Tools\DynamoCoreRuntime\$(DynamoVersion.Substring(0, $(DynamoVersion.LastIndexOf('.'))))</DynamoRuntimeRoot>
  </PropertyGroup>

  <!--
    Every DynamoVisualProgramming.* PackageReference must carry
      ExcludeAssets="runtime" PrivateAssets="all"
    so Dynamo's assemblies are compile-time only and never copied into bin\.
  -->

</Project>
