<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ZeroTouch node library exposing the Inventor API to Dynamo. Most of the API\ folder is
    generated by NodeGeneration\DSLibraryGenerator; hand-written parts are GeometryConversion,
    ModulePlacement and Work Geometry.
  -->

  <PropertyGroup>
    <RootNamespace>InventorLibrary</RootNamespace>
    <AssemblyName>InventorLibrary</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Present on disk but never part of the build in the original project; left out until reviewed. -->
    <Compile Remove="API\InvOGSSceneNode.cs" />
    <Compile Remove="InvWorkPoint.cs" />
    <Compile Remove="ModulePlacement\DSAssemblyComponent.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(StdOlePath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Core pulls in ZeroTouchLibrary (ProtoGeometry, DynamoUnits) and DynamoServices transitively. -->
    <PackageReference Include="DynamoVisualProgramming.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SimpleInjector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventorServices\InventorServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dynamo reads this next to the DLL to customise node categories/names in the library. -->
    <None Include="InventorLibrary_DynamoCustomization.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Autodesk.Inventor.interop.xml" />
  </ItemGroup>

</Project>
