<Project Sdk="Microsoft.NET.Sdk">

  <!-- Inventor-side persistence and binding services (reference keys, trace ids, IoC). No Dynamo UI. -->

  <PropertyGroup>
    <RootNamespace>InventorServices</RootNamespace>
    <AssemblyName>InventorServices</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DynamoVisualProgramming.DynamoServices" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SimpleInjector" />
  </ItemGroup>

</Project>
